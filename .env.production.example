# Hosted Supabase (Connect > ORMs > Prisma). Copy to .env.production (gitignored).
# Used only by `npm run db:deploy:prod`. On your hosting platform, set the same
# two variables in its environment settings instead of shipping this file.
# Local dev keeps using .env (Docker Supabase) and is unaffected.

# Transaction pooler (port 6543), used by the running app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session connection (port 5432), used by `prisma migrate`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
