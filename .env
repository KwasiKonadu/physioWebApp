# Copy to .env and fill in. .env is gitignored.

# --- Local development (Supabase CLI, runs in Docker) ---
# `supabase start` brings up the stack; Postgres is on 127.0.0.1:54522.
# No pooler runs locally, so DATABASE_URL and DIRECT_URL are identical.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54522/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54522/postgres"

# --- Production (Supabase project > Connect) ---
# DATABASE_URL = pooled connection (transaction pooler, add ?pgbouncer=true)
# DIRECT_URL   = direct connection (used by `prisma migrate`)
